---
import ArtworkDetail from "@/components/ArtworkDetail";
import "@/components/gallery.css";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getArtworks } from "@/lib/artworks";
import { getSiteSettings } from "@/lib/settings";
import { getSiteUrl } from "@/lib/site";
import type { Artwork } from "@/lib/types";

export async function getStaticPaths() {
  const artworks = await getArtworks();
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
    props: { artwork }
  }));
}

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const settings = await getSiteSettings();
const canonicalUrl = `${getSiteUrl()}/artworks/${artwork.slug}`;
const description = artwork.description || `${artwork.title} by ${settings.artistName}.`;
const pageImage = artwork.detailImages[0]?.src || artwork.coverImage.src;
---

<SiteLayout
  title={`${artwork.title} | ${settings.artistName}`}
  description={description}
  image={pageImage}
  canonical={canonicalUrl}
  contactEmail={settings.contactEmail}
  artistName={settings.artistName}
>
  <div class="page-shell">
    <ArtworkDetail
      artwork={artwork}
      canonicalUrl={canonicalUrl}
      contactEmail={settings.contactEmail}
      artistName={settings.artistName}
      client:load
    />
  </div>
</SiteLayout>
